# Host user/group used by docker-compose services so mounted ./data and ./logs stay writable.
PUID=1000
PGID=1000

# Host directories mounted into worker/web/sqlite-web containers.
HOST_DATA_DIR=./data
HOST_LOGS_DIR=./logs

# Host address used to publish the trading dashboard. On a Tailscale server,
# set this to the server's `tailscale ip -4` result (usually a 100.x.y.z IP).
# The Compose default is 127.0.0.1, so omitting this never exposes port 5000
# through the server's public network interface.
# WEB_BIND_IP=100.x.y.z

# Persistent JSON evidence written before every automatic SQLite rebuild.
SQLITE_RECOVERY_LOG_DIR=logs/sqlite-recovery

# Independent SQLite databases inside the worker/web containers.
# If the server has no old database files, keep these defaults; the app creates them automatically.
DATA_DIR=data
BASE_DB_PATH=data/base_data.db
CONFIG_DB_PATH=data/config.db
SCORING_DB_PATH=data/scoring.db
TRADING_DB_PATH=data/trading.db
TRADING_CORE_DB_PATH=data/trading_core.db
MARKET_DB_PATH=data/market.db

# Maximum wait for the current ALLUSDT aggregation before profit protection
# falls back to the latest available data and continues trailing-stop scans.
PROFIT_MARKET_CONVERGENCE_TIMEOUT_SEC=10

# Database opened by the sqlite-web container. Change to /data/scoring.db,
# /data/config.db, /data/trading.db, /data/trading_core.db, or /data/market.db when you want to inspect another module DB.
SQLITE_WEB_DB_PATH=/data/base_data.db

BINANCE_TESTNET=true
BINANCE_TESTNET_API_KEY=YOUR_TESTNET_API_KEY
BINANCE_TESTNET_SECRET_KEY=YOUR_TESTNET_SECRET_KEY
BINANCE_REAL_API_KEY=YOUR_REAL_API_KEY
BINANCE_REAL_API_SECRET=YOUR_REAL_API_SECRET
# Optional production endpoint override. Normally leave this unchanged.
BINANCE_REAL_BASE_URL=https://fapi.binance.com
